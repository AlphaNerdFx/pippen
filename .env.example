# Copy to .env and adjust. .env is gitignored and must never be committed.

# Where nba-impact caches data. Defaults to ./data in a checkout.
# NBA_IMPACT_DATA_DIR=/path/to/data

# Identify yourself to the NBA stats endpoints. Required by their servers.
NBA_API_USER_AGENT="nba-impact/0.0.0 (+https://github.com/AlphaNerdFx/nba-impact)"

# Seconds to wait between NBA API requests. Their limit is roughly one per second.
NBA_API_RATE_LIMIT_SECONDS=1.0

# MLflow tracking location. A local directory needs no server.
MLFLOW_TRACKING_URI=file:./mlruns
