# Copy to .env and adjust. .env is gitignored and must never be committed.

# Where pippen caches data. Defaults to ./data in a checkout.
# PIPPEN_DATA_DIR=/path/to/data

# Identify yourself to the NBA stats endpoints. Required by their servers.
PIPPEN_USER_AGENT="pippen/0.0.0 (+https://github.com/AlphaNerdFx/pippen)"

# Seconds to wait between NBA API requests. Their limit is roughly one per second.
NBA_API_RATE_LIMIT_SECONDS=1.0

# MLflow tracking location. A local directory needs no server.
MLFLOW_TRACKING_URI=file:./mlruns
